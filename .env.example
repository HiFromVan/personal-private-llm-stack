# 模型名称或 Hugging Face 模型目录。这里的模型可以随时替换。
# RTX 3090 24GB 推荐使用 Qwen2.5-Coder-32B 的 AWQ 4-bit 量化版本。
MODEL_NAME=Qwen/Qwen2.5-Coder-32B-Instruct-AWQ

# 必须改成一串随机的长字符串；远程客户端请求时放在 Authorization: Bearer 中。
VLLM_API_KEY=change-this-to-a-long-random-key

# 如果模型需要访问 Hugging Face 私有仓库，再填写；公开模型可以留空。
HF_TOKEN=

# 24GB 显存的保守默认值。需要更长上下文时应同步降低并发。
VLLM_GPU_MEMORY_UTILIZATION=0.92
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=1
VLLM_DTYPE=auto
